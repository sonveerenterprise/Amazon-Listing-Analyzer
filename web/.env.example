# Optional. Without it the app runs the free rule checks only.
ANTHROPIC_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# AI analyses allowed per IP address per hour (public deployments)
# AI_RATE_LIMIT_PER_HOUR=5

# --- Team features (Helium 10 data) ---
# Shared team password, at least 8 characters. Leave empty to switch team features off.
TEAM_PASSWORD=
# Public address of this app, used for the Helium 10 sign-in redirect.
# APP_URL=https://analyzer.yourdomain.com
# H10_MCP_URL=https://mcp.helium10.com/mcp
# Helium 10 calls the app always leaves unused in each period
# H10_RESERVE_CALLS=20

# --- Full reports (team only): Claude runs the repository's skill ---
# Needs ANTHROPIC_API_KEY above and TEAM_PASSWORD.
# REPORT_MODEL=claude-opus-5-5
# Spending limit for one report, in US dollars
# REPORT_MAX_USD=10
# Helium 10 calls one report may use
# REPORT_H10_MAX_CALLS=12
# Browser used to read Amazon pages. By default the installed Google Chrome is used,
# then Playwright's Chromium (install it with: npx playwright install chromium).
# BROWSER_HEADLESS=false   # show the browser window while it works
# CHROMIUM_PATH=/path/to/chrome
